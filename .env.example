# ⚡ SonicVault (SpotiMP4) Environment Configuration

# Optional: Music directory override (defaults to ~/Música or ./musica)
# MUSIC_DIR=/path/to/your/music

# ---------------------------------------------------------------------------
# OmniRoute AI Provider Keys (At least 1 recommended for LLM intelligence)
# ---------------------------------------------------------------------------

# Primary Provider: Google Gemini API (Free Tier)
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Secondary Fallback: Groq API (Free Tier Llama 3)
# Get free key at: https://console.groq.com/
GROQ_API_KEY=

# Tertiary Fallback: OpenRouter API (Free Models)
# Get free key at: https://openrouter.ai/
OPENROUTER_API_KEY=
